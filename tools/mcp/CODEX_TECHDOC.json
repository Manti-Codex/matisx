{
  "schema_version": "1.0",
  "type": "mantisx_mcp_registry_contract",
  "audience": "codex",
  "primary_registry": "tools/mcp/registry.json",
  "expected_top_level_keys": [
    "schema_version",
    "servers"
  ],
  "server_entry_contract": {
    "required_fields": [
      "name"
    ],
    "recommended_fields": [
      "transport",
      "command",
      "args",
      "env",
      "url",
      "enabled"
    ],
    "transport_values": [
      "stdio",
      "http",
      "sse"
    ]
  },
  "write_policy": [
    "Default to enabled=false for newly added third-party servers unless user asks to activate immediately.",
    "Keep secrets out of file content; use env variable names only."
  ]
}
